# Local development env for the AMD Track 1 agent.
# The grading harness INJECTS these at runtime — these values are for local dev only.
# Copy to a real (git/docker-ignored) file:   cp .env.example .env
# NEVER commit a real .env and NEVER bundle it into the Docker image.

# Fireworks API key (from the Fireworks dashboard). Secret — keep it out of git.
FIREWORKS_API_KEY=your_fireworks_api_key_here

# OpenAI-compatible base URL for Fireworks inference.
# All model calls MUST go through this URL — never hardcode an endpoint.
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Comma-separated allowed model IDs. The harness OVERRIDES this at runtime;
# the value here only mirrors the confirmed Track 1 list for local dev.
# Code must always read this from the environment, never hardcode model IDs.
ALLOWED_MODELS=minimax-m3,kimi-k2p7-code,gemma-4-31b-it,gemma-4-26b-a4b-it,gemma-4-31b-it-nvfp4
